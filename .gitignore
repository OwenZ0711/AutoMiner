# macOS
.DS_Store
Thumbs.db

# Python bytecode / build artifacts (match anywhere)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual envs — anchored to repo root only (don't match arbitrary `env/` or `venv/`
# directories deep inside vendored repos)
/.venv/
/venv/
/venvs/
/env/

# Editor / tooling
.vscode/
.idea/
*.swp
*.swo

# Top-level build dirs (anchored)
/build/
/dist/

# MLflow local artifacts (regenerable)
mlruns/

# Project-local data (anchored — real data lives at ~/AutoLLM_data/ per CLAUDE.md).
/data/
/results/

# Raw futures minute data (68 GB, read-only pipeline input — never belongs in git)
/Future_minute_data/

# Data file blobs at the repo root (not used today; defensive). Test fixtures are
# whitelisted explicitly so small checked-in fixtures still ship.
/*.parquet
/*.bin
!data_fetcher/tests/fixtures/**/*.parquet
